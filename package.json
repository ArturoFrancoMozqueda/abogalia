{
  "name": "abogalia",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev:web": "pnpm --filter @abogalia/web dev",
    "build": "pnpm --filter @abogalia/web build",
    "typecheck": "pnpm --filter @abogalia/web typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "pnpm lint && pnpm typecheck && pnpm build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15"
  }
}
