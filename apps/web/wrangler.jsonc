{
  // Local template only: A0 must bind the actual Legalia account/hostname.
  "name": "legalia-web",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-15",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false },
  "assets": {
    "directory": "build/client",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "vars": {
    // Empty plus an empty source allowlist denies all upstream requests.
    "LEGALIA_API_ORIGIN": ""
  }
}
