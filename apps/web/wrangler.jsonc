{
  // Local template only: A0 must bind the actual Legalia account/hostname.
  "name": "legalia-web",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-15",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": false,
    "redact_query_string": true,
    "logs": { "enabled": false, "invocation_logs": false, "persist": false },
    "traces": { "enabled": false, "persist": false }
  },
  "assets": {
    "directory": "build/client",
    "binding": "ASSETS",
    "run_worker_first": ["/*", "!/assets/*"],
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "vars": {
    // Empty origin denies all upstream requests.
    "LEGALIA_API_ORIGIN": ""
  }
}
